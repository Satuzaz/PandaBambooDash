{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Panda Bamboo Dash",
            "type": "shell",
            "command": "javac",
            "args": ["--release", "17", "-encoding", "UTF-8", "-d", "out/vscode", "src/*.java"],
            "options": {"cwd": "${workspaceFolder}"},
            "group": {"kind": "build", "isDefault": true},
            "problemMatcher": ["$javac"]
        }
    ]
}
