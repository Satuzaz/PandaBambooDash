import java.awt.*;
import java.awt.image.BufferedImage;
import java.util.HashMap;
import java.util.Map;

/** Presentation only. GamePanel owns input, game state and the world. */
public final class UIManager {
    private static final Color INK = new Color(48,76,30);
    private static final String MOVE = "A/D or \u2190/\u2192 Move";
    private static final String JUMP = "W / \u2191 / SPACE Jump";
    private final Assets assets;
    private final Map<String,BufferedImage> pictures = new HashMap<>();

    public UIManager(Assets assets) {
        this.assets = assets;
        for (String name : new String[]{"logo","button_start","button_howtoplay","button_exit",
                "button_retry","button_menu","button_next"}) {
            pictures.put(name,trim(assets.get("ui/"+name+".png")));
        }
    }
    /** Common geometry for hit testing and rendering, in 1280 x 720 UI coordinates. */
    public static Rectangle bounds(String name) {
        switch(name) {
            case "start": return new Rectangle(480,350,320,58);
            case "help": return new Rectangle(480,426,320,58);
            case "exit": return new Rectangle(480,502,320,58);
            case "retry": case "next": return new Rectangle(480,390,320,58);
            case "menu": return new Rectangle(480,466,320,58);
            default: throw new IllegalArgumentException("Unknown button: "+name);
        }
    }
    private static BufferedImage trim(BufferedImage image) {
        int minX=image.getWidth(), minY=image.getHeight(), maxX=-1, maxY=-1;
        for(int y=0;y<image.getHeight();y++) for(int x=0;x<image.getWidth();x++) {
            if ((image.getRGB(x,y) >>> 24)>32) {
                minX=Math.min(minX,x); minY=Math.min(minY,y); maxX=Math.max(maxX,x); maxY=Math.max(maxY,y);
            }
        }
        return maxX<0 ? image : image.getSubimage(minX,minY,maxX-minX+1,maxY-minY+1);
    }
    private void quality(Graphics2D g) {
        g.setRenderingHint(RenderingHints.KEY_ANTIALIASING,RenderingHints.VALUE_ANTIALIAS_ON);
        g.setRenderingHint(RenderingHints.KEY_TEXT_ANTIALIASING,RenderingHints.VALUE_TEXT_ANTIALIAS_ON);
        g.setRenderingHint(RenderingHints.KEY_INTERPOLATION,RenderingHints.VALUE_INTERPOLATION_BILINEAR);
    }
    private void text(Graphics2D g,String value,int size,int y,Color color) {
        g.setFont(new Font("SansSerif",Font.BOLD,size)); g.setColor(color);
        g.drawString(value,(1280-g.getFontMetrics().stringWidth(value))/2,y);
    }
    private void fit(Graphics2D g,BufferedImage image,int x,int y,int w,int h) {
        double scale=Math.min(w/(double)image.getWidth(),h/(double)image.getHeight());
        int iw=(int)(image.getWidth()*scale), ih=(int)(image.getHeight()*scale);
        g.drawImage(image,x+(w-iw)/2,y+(h-ih)/2,iw,ih,null);
    }
    private void overlay(Graphics2D g,int alpha) {
        g.setColor(new Color(8,28,19,alpha)); g.fillRect(0,0,1280,720);
    }
    private void bamboo(Graphics2D g,int x,int y,int height) {
        g.setPaint(new GradientPaint(x,y,new Color(149,193,66),x+18,y,new Color(60,111,36)));
        g.fillRoundRect(x,y,18,height,14,14);
        g.setColor(new Color(221,231,143));
        for(int at=y+20;at<y+height-6;at+=45) { g.fillRoundRect(x-2,at,22,5,4,4); }
        g.setColor(new Color(45,88,27)); g.drawRoundRect(x,y,18,height,14,14);
    }
    private void card(Graphics2D g,int x,int y,int w,int h) {
        g.setColor(new Color(8,34,15,80)); g.fillRoundRect(x+2,y+9,w,h,38,38);
        g.setColor(new Color(87,116,40)); g.fillRoundRect(x,y,w,h,38,38);
        g.setPaint(new GradientPaint(x,y,new Color(255,249,216),x,y+h,new Color(238,225,174)));
        g.fillRoundRect(x+6,y+6,w-12,h-12,30,30);
        g.setColor(new Color(255,255,239,190)); g.drawRoundRect(x+11,y+11,w-22,h-22,24,24);
        bamboo(g,x-5,y+24,h-48); bamboo(g,x+w-13,y+24,h-48);
    }
    private void icon(Graphics2D g,String name,int x,int y) {
        g.setColor(new Color(253,245,196));
        g.setStroke(new BasicStroke(2.5f,BasicStroke.CAP_ROUND,BasicStroke.JOIN_ROUND));
        if (name.equals("start") || name.equals("next")) {
            g.fillPolygon(new int[]{x+9,x+9,x+23},new int[]{y+7,y+25,y+16},3);
        } else if (name.equals("menu")) {
            g.fillPolygon(new int[]{x+5,x+16,x+27},new int[]{y+15,y+5,y+15},3);
            g.fillRoundRect(x+9,y+14,15,13,3,3);
        } else if (name.equals("retry")) {
            g.drawArc(x+7,y+7,19,19,30,290); g.fillPolygon(new int[]{x+22,x+29,x+28},new int[]{y+5,y+8,y+0},3);
        } else if (name.equals("exit")) {
            g.drawArc(x+7,y+8,19,19,45,270); g.drawLine(x+16,y+3,x+16,y+15);
        } else {
            g.setFont(new Font("SansSerif",Font.BOLD,24)); g.drawString("?",x+9,y+25);
        }
        g.setStroke(new BasicStroke(1));
    }
    private void button(Graphics2D g,String name,Point hover) {
        Rectangle r=bounds(name);
        boolean hot=r.contains(hover);
        g.setColor(new Color(56,73,22,75)); g.fillRoundRect(r.x,r.y+5,r.width,r.height,24,24);
        g.setColor(hot ? new Color(183,206,91) : new Color(122,158,53));
        g.fillRoundRect(r.x,r.y,r.width,r.height,24,24);
        g.setColor(new Color(235,229,153)); g.drawRoundRect(r.x+2,r.y+2,r.width-4,r.height-4,22,22);
        g.setColor(new Color(48,89,29)); g.fillOval(r.x+12,r.y+12,34,34);
        icon(g,name,r.x+13,r.y+12);
        String file=name.equals("help") ? "button_howtoplay" : "button_"+name;
        fit(g,pictures.get(file),r.x+53,r.y+4,r.width-67,r.height-8);
        // Bamboo joints at the ends keep all button artwork in one visual family.
        g.setColor(new Color(222,232,148,160));
        g.drawLine(r.x+7,r.y+15,r.x+7,r.y+r.height-15);
        g.drawLine(r.x+r.width-8,r.y+15,r.x+r.width-8,r.y+r.height-15);
    }
    public void renderMainMenu(Graphics2D g,Point hover,boolean help) {
        quality(g);
        BufferedImage bg=assets.get("background/level1.png");
        double scale=Math.max(1280.0/bg.getWidth(),720.0/bg.getHeight());
        int w=(int)Math.ceil(bg.getWidth()*scale),h=(int)Math.ceil(bg.getHeight()*scale);
        g.drawImage(bg,(1280-w)/2,(720-h)/2,w,h,null); overlay(g,28);
        fit(g,pictures.get("logo"),330,26,620,235);
        card(g,424,283,432,301);
        text(g,"LET'S GO, LITTLE PANDA!",16,325,INK);
        button(g,"start",hover); button(g,"help",hover); button(g,"exit",hover);
        card(g,405,612,470,82);
        text(g,MOVE,16,645,INK); text(g,JUMP,16,672,INK);
        if(help) renderHelp(g,hover);
    }
    private void renderHelp(Graphics2D g,Point hover) {
        overlay(g,155); card(g,325,145,630,420);
        text(g,"HOW TO PLAY",34,211,INK);
        text(g,MOVE,19,267,INK); text(g,JUMP,19,300,INK);
        text(g,"Collect 5 bamboo in each of the 3 levels.",18,350,INK);
        text(g,"Avoid snakes and pits. Keep your 3 hearts!",18,386,INK);
        text(g,"Finish Level 3 to win!",18,421,INK);
        button(g,"menu",hover);
    }
    public void renderHUD(Graphics2D g,Player player,Level level) {
        quality(g);
        g.setColor(new Color(19,53,31,160)); g.fillRoundRect(24,16,1232,48,24,24);
        g.setColor(new Color(237,238,173,155)); g.drawRoundRect(24,16,1232,48,24,24);
        for(int i=0;i<3;i++) fit(g,assets.get("ui/heart_"+(i<player.getHearts()?"full":"empty")+".png"),44+38*i,25,30,30);
        text(g,"Level "+level.getNumber()+"/3 - "+level.getName(),19,47,new Color(255,251,222));
        fit(g,assets.get("item/bamboo.png"),1131,22,27,35);
        g.setFont(new Font("SansSerif",Font.BOLD,19)); g.drawString(player.getBamboo()+" / 5",1173,47);
        g.setColor(new Color(19,53,31,175)); g.fillRoundRect(24,670,455,30,12,12);
        g.setColor(new Color(248,246,216)); g.setFont(new Font("SansSerif",Font.PLAIN,12));
        g.drawString(MOVE+"  |  "+JUMP,38,690);
    }
    public void renderGameOver(Graphics2D g,Point hover) { result(g,hover,false); }
    public void renderWin(Graphics2D g,Point hover) { result(g,hover,true); }
    private void result(Graphics2D g,Point hover,boolean won) {
        quality(g); overlay(g,165); card(g,350,152,580,416);
        fit(g,pictures.get("logo"),550,174,180,65);
        text(g,won ? "YOU WIN!" : "GAME OVER",44,298,INK);
        text(g,won ? "All 3 levels complete. Bamboo-tiful!" : "Take a breath. Let's try again!",18,342,INK);
        button(g,"retry",hover); button(g,"menu",hover);
    }
}
