import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.util.concurrent.atomic.AtomicBoolean;
import java.util.concurrent.atomic.AtomicReference;

public final class GamePanel extends JPanel implements Runnable {
    public static final int SCREEN_WIDTH = 1280;
    public static final int SCREEN_HEIGHT = 720;
    // Keep level geometry and physics in the original logical coordinate space.
    private static final int WORLD_WIDTH = 800;
    private static final int WORLD_HEIGHT = 600;
    private final Assets assets;
    private final Object modelLock = new Object();
    private final AtomicBoolean left = new AtomicBoolean(), right = new AtomicBoolean();
    private final AtomicBoolean spaceHeld = new AtomicBoolean(), jumpRequested = new AtomicBoolean();
    private int heldKeys;
    private static final String CONTROL_HINT = "A/D or \u2190/\u2192 Move | W/\u2191/SPACE Jump";
    private final AtomicReference<String> command = new AtomicReference<>();
    private volatile boolean running;
    private Thread loop;
    private GameState state = GameState.MENU;
    private Player player;
    private Level level;
    private final Rectangle primaryButton = new Rectangle(480,350,320,58);
    private final Rectangle howButton = new Rectangle(480,426,320,58);
    private final Rectangle exitButton = new Rectangle(480,502,320,58);
    private final Rectangle retryButton = new Rectangle(480,390,320,58);
    private final Rectangle menuButton = new Rectangle(480,466,320,58);
    private boolean showingHelp;
    private Point hover = new Point(-1,-1);

    public GamePanel() throws Exception {
        assets = new Assets();
        setPreferredSize(new Dimension(SCREEN_WIDTH, SCREEN_HEIGHT));
        setDoubleBuffered(true);
        String[] keys = {"LEFT", "A", "RIGHT", "D", "SPACE", "UP", "W"};
        for (int i = 0; i < keys.length; i++) {
            final int bit = 1 << i;
            bind("pressed " + keys[i], () -> setKeyHeld(bit, true));
            bind("released " + keys[i], () -> setKeyHeld(bit, false));
        }
        addMouseListener(new MouseAdapter() {
            @Override public void mousePressed(MouseEvent e) {
                if (!SwingUtilities.isLeftMouseButton(e)) return;
                double x = e.getX() * (double) SCREEN_WIDTH / getWidth();
                double y = e.getY() * (double) SCREEN_HEIGHT / getHeight();
                synchronized (modelLock) {
                    if (state == GameState.MENU) {
                        if (showingHelp) { if (menuButton.contains(x,y)) showingHelp = false; }
                        else if (primaryButton.contains(x,y)) command.set("primary");
                        else if (howButton.contains(x,y)) showingHelp = true;
                        else if (exitButton.contains(x,y)) {
                            Window window = SwingUtilities.getWindowAncestor(GamePanel.this);
                            if (window != null) window.dispatchEvent(new WindowEvent(window,WindowEvent.WINDOW_CLOSING));
                        }
                    } else if (state != GameState.PLAYING) {
                        if (retryButton.contains(x,y)) command.set("primary");
                        else if (menuButton.contains(x,y)) command.set("menu");
                    }
                }
                repaint();
            }
        });
        addMouseMotionListener(new MouseMotionAdapter() {
            @Override public void mouseMoved(MouseEvent e) {
                hover = new Point(e.getX()*SCREEN_WIDTH/getWidth(),e.getY()*SCREEN_HEIGHT/getHeight());
                repaint();
            }
        });
        addMouseListener(new MouseAdapter() {
            @Override public void mouseExited(MouseEvent e) { hover = new Point(-1,-1); repaint(); }
        });
    }
    private void bind(String key, Runnable action) {
        getInputMap(WHEN_IN_FOCUSED_WINDOW).put(KeyStroke.getKeyStroke(key),key);
        getActionMap().put(key,new AbstractAction() {
            @Override public void actionPerformed(ActionEvent e) { action.run(); }
        });
    }
    public void start() {
        if (running) return;
        running = true;
        SwingUtilities.getWindowAncestor(this).addWindowFocusListener(new WindowAdapter() {
            @Override public void windowLostFocus(WindowEvent e) { clearInput(); }
        });
        loop = new Thread(this,"Panda-Game-Loop");
        loop.setDaemon(true); loop.start();
    }
    private synchronized void setKeyHeld(int bit, boolean pressed) {
        heldKeys = pressed ? heldKeys | bit : heldKeys & ~bit;
        left.set((heldKeys & 3) != 0);
        right.set((heldKeys & 12) != 0);
        boolean jumping = (heldKeys & 112) != 0;
        if (jumping && !spaceHeld.get()) jumpRequested.set(true);
        spaceHeld.set(jumping);
    }
    private synchronized void clearInput() {
        heldKeys = 0;
        left.set(false); right.set(false); spaceHeld.set(false); jumpRequested.set(false);
    }
    @Override public void removeNotify() { running = false; if (loop != null) loop.interrupt(); super.removeNotify(); }
    private void newGame() {
        clearInput(); player = new Player(assets); loadLevel(1); state = GameState.PLAYING;
    }
    private void loadLevel(int number) {
        switch (number) {
            case 1: level = new Level1(assets); break;
            case 2: level = new Level2(assets); break;
            case 3: level = new Level3(assets); break;
            default: throw new IllegalArgumentException("Invalid level");
        }
        player.enterLevel(level);
    }
    private void update(double dt) {
        String action = command.getAndSet(null);
        if (state != GameState.PLAYING) {
            if ("primary".equals(action)) newGame();
            else if ("menu".equals(action) && state != GameState.MENU) { state = GameState.MENU; clearInput(); }
            jumpRequested.set(false);
            return;
        }
        player.move((right.get() ? 1 : 0) - (left.get() ? 1 : 0));
        if (jumpRequested.getAndSet(false)) player.jump();
        player.update(dt);
        level.update(dt,player);
        if (player.getHearts() == 0) { state = GameState.GAMEOVER; clearInput(); }
        else if (player.getBamboo() == 5) {
            if (level.getNumber() == 3) { state = GameState.WIN; clearInput(); }
            else { loadLevel(level.getNumber()+1); jumpRequested.set(false); }
        }
    }
    @Override public void run() {
        final double step = 1.0 / 60.0;
        long previous = System.nanoTime();
        double accumulated = 0;
        while (running) {
            long now = System.nanoTime();
            accumulated += Math.min((now-previous)/1_000_000_000.0,0.1); previous = now;
            synchronized (modelLock) {
                while (accumulated >= step) { update(step); accumulated -= step; }
            }
            repaint();
            try { Thread.sleep(Math.max(1,(long)((step-accumulated)*1000))); }
            catch (InterruptedException e) { Thread.currentThread().interrupt(); break; }
        }
    }
    @Override protected void paintComponent(Graphics graphics) {
        super.paintComponent(graphics);
        Graphics2D g = (Graphics2D)graphics.create();
        g.scale(getWidth() / (double) SCREEN_WIDTH, getHeight() / (double) SCREEN_HEIGHT);
        g.setRenderingHint(RenderingHints.KEY_ANTIALIASING,RenderingHints.VALUE_ANTIALIAS_ON);
        g.setRenderingHint(RenderingHints.KEY_TEXT_ANTIALIASING,RenderingHints.VALUE_TEXT_ANTIALIAS_ON);
        g.setRenderingHint(RenderingHints.KEY_INTERPOLATION,RenderingHints.VALUE_INTERPOLATION_BILINEAR);
        synchronized (modelLock) {
            if (state == GameState.PLAYING) {
                renderWorld(g); renderHUD(g);
            } else {
                if (state == GameState.MENU) renderMenu(g);
                else if (state == GameState.WIN) renderWin(g);
                else renderGameOver(g);
            }
        }
        g.dispose();
    }
    private void renderWorld(Graphics2D g) {
        Graphics2D world = (Graphics2D)g.create();
        world.scale(SCREEN_WIDTH/(double)WORLD_WIDTH,SCREEN_HEIGHT/(double)WORLD_HEIGHT);
        level.draw(world); player.draw(world); world.dispose();
    }
    private void centered(Graphics2D g, String text, int y) {
        g.drawString(text,(SCREEN_WIDTH-g.getFontMetrics().stringWidth(text))/2,y);
    }
    private void textStyle(Graphics2D g, int size, boolean bold, Color color) {
        g.setFont(new Font("SansSerif",bold ? Font.BOLD : Font.PLAIN,size)); g.setColor(color);
    }
    private void overlay(Graphics2D g, int alpha) {
        g.setColor(new Color(4,20,17,alpha)); g.fillRect(0,0,SCREEN_WIDTH,SCREEN_HEIGHT);
    }
    private void panel(Graphics2D g, int x, int y, int w, int h) {
        g.setColor(new Color(0,0,0,60)); g.fillRoundRect(x,y+8,w,h,28,28);
        g.setColor(new Color(15,40,32,246)); g.fillRoundRect(x,y,w,h,28,28);
        g.setColor(new Color(170,196,119,130)); g.drawRoundRect(x,y,w,h,28,28);
    }
    private void button(Graphics2D g, String label, Rectangle r, boolean primary) {
        boolean hot = r.contains(hover);
        g.setPaint(new GradientPaint(r.x,r.y,
                primary ? new Color(hot ? 125 : 104,156,66) : new Color(hot ? 53 : 35,78,57),
                r.x,r.y+r.height,primary ? new Color(60,105,42) : new Color(22,52,40)));
        g.fillRoundRect(r.x,r.y,r.width,r.height,16,16);
        g.setColor(new Color(188,207,143,hot ? 230 : 140));
        g.drawRoundRect(r.x,r.y,r.width,r.height,16,16);
        textStyle(g,20,true,new Color(250,245,222));
        g.drawString(label,r.x+(r.width-g.getFontMetrics().stringWidth(label))/2,
                r.y+(r.height-g.getFontMetrics().getHeight())/2+g.getFontMetrics().getAscent());
    }
    private void renderMenu(Graphics2D g) {
        java.awt.image.BufferedImage bg = assets.get("background/level1.png");
        double scale = Math.max(SCREEN_WIDTH/(double)bg.getWidth(),SCREEN_HEIGHT/(double)bg.getHeight());
        int w = (int)Math.ceil(bg.getWidth()*scale), h = (int)Math.ceil(bg.getHeight()*scale);
        g.drawImage(bg,(SCREEN_WIDTH-w)/2,(SCREEN_HEIGHT-h)/2,w,h,null);
        overlay(g,100);
        java.awt.image.BufferedImage logo = assets.get("ui/logo.png");
        double logoScale = Math.min(560.0/logo.getWidth(),225.0/logo.getHeight());
        int lw=(int)(logo.getWidth()*logoScale), lh=(int)(logo.getHeight()*logoScale);
        g.drawImage(logo,(SCREEN_WIDTH-lw)/2,66+(225-lh)/2,lw,lh,null);
        textStyle(g,17,false,new Color(241,238,214));
        centered(g,"A little panda. A bamboo adventure.",310);
        button(g,"Start Game",primaryButton,true);
        button(g,"How To Play",howButton,false);
        button(g,"Exit",exitButton,false);
        textStyle(g,13,false,new Color(231,235,219));
        centered(g,CONTROL_HINT,686);
        if (showingHelp) {
            overlay(g,150); panel(g,340,155,600,410);
            textStyle(g,32,true,new Color(248,238,203)); centered(g,"How To Play",215);
            textStyle(g,18,false,new Color(219,230,210));
            centered(g,CONTROL_HINT,277);
            centered(g,"Collect 5 bamboo in each of the 3 levels.",319);
            centered(g,"Avoid snakes and cave pits. You have 3 hearts.",361);
            centered(g,"Finish Level 3 to win!",403);
            button(g,"Back",menuButton,true);
        }
    }
    private void renderHUD(Graphics2D g) {
        panel(g,24,16,1232,56);
        for (int i=0;i<3;i++) g.drawImage(assets.get("ui/heart_"+(i<player.getHearts()?"full":"empty")+".png"),44+i*40,29,30,30,null);
        textStyle(g,19,true,new Color(246,240,214));
        centered(g,"Level "+level.getNumber()+" / 3  ·  "+level.getName(),51);
        g.drawImage(assets.get("item/bamboo.png"),1140,27,23,34,null);
        g.drawString(player.getBamboo()+" / 5",1180,51);
        g.setColor(new Color(8,25,20,175)); g.fillRoundRect(24,671,405,28,10,10);
        textStyle(g,12,false,new Color(224,232,214));
        g.drawString(CONTROL_HINT+(level.getNumber()==3 ? "   ·   Watch the pits!" : ""),36,690);
    }
    private void renderGameOver(Graphics2D g) { renderResult(g,false); }
    private void renderWin(Graphics2D g) { renderResult(g,true); }
    private void renderResult(Graphics2D g, boolean won) {
        renderWorld(g); overlay(g,170); panel(g,360,160,560,400);
        textStyle(g,13,true,new Color(169,192,125)); centered(g,"PANDA BAMBOO DASH",209);
        textStyle(g,46,true,new Color(249,239,204)); centered(g,won ? "YOU WIN!" : "GAME OVER",280);
        textStyle(g,18,false,new Color(215,226,208));
        centered(g,won ? "All 3 levels complete. Well done!" : "A fresh adventure is one try away.",323);
        button(g,"Retry",retryButton,true); button(g,"Main Menu",menuButton,false);
    }
}
