{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Panda Bamboo Dash",
            "type": "process",
            "command": "${config:java.jdt.ls.java.home}/bin/javac.exe",
            "args": ["--release", "17", "-encoding", "UTF-8", "-d", "out/classes", "-sourcepath", "src", "src/Main.java"],
            "options": {"cwd": "${workspaceFolder}"},
            "group": {"kind": "build", "isDefault": true},
            "problemMatcher": ["$javac"]
        }
    ]
}
